{{- $profile := promptString "profile" -}}
{{- if not (or (eq $profile "desktop") (eq $profile "server") (eq $profile "container")) -}}
{{- fail "profile must be desktop, server, or container" -}}
{{- end -}}
{{- $gitName := promptString "gitName" -}}
{{- $gitEmail := promptString "gitEmail" -}}
{{- $repoDir := promptString "repoDir" -}}
{{- if not $repoDir -}}
{{- fail "repoDir must be set (bootstrap passes it; manually: --promptString repoDir=<absolute path of the workstation repo>)" -}}
{{- end -}}
sourceDir = {{ $repoDir | quote }}

[data]
profile = {{ $profile | quote }}
gitName = {{ $gitName | quote }}
gitEmail = {{ $gitEmail | quote }}
repoDir = {{ $repoDir | quote }}
